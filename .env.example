# Copier vers .env.local et remplir avant de lancer `npm run dev`
AIRTABLE_TOKEN=patXXXXXXXXXXXXXX
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
JWT_SECRET=generate-with-openssl-rand-base64-48

# Optional — Upstash Redis for per-IP rate limiting (login/signup/vote).
# App runs fine without these (limiter is no-op when env vars absent).
# Free tier at https://upstash.com/ → Redis → REST API.
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AXXXXX...

# Optional — Sentry error monitoring. App runs fine without these (no-op).
# Get DSN from sentry.io/settings/[org]/projects/[proj]/keys/
# NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_ORG=your-sentry-org
# SENTRY_PROJECT=pulse
# SENTRY_AUTH_TOKEN=sntrys_...   # only needed for source map upload at build
